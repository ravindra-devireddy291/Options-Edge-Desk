# Desk API
DESK_API_KEY=change-me-desk-api-key
DESK_MODE=paper
DESK_HOST=127.0.0.1
DESK_PORT=8080

# Dhan HQ v2 — paste once; desk auto-renews while process stays up
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional unattended daily login if token fully expires (TOTP enabled on Dhan):
# DHAN_PIN=123456
# DHAN_TOTP_SECRET=BASE32SECRET

# Edge Lab roots
NIFTY_LAB_ROOT=D:/Options-Nifty-Edge-Lab
BN_LAB_ROOT=D:/Options-Edge-Lab
# VPS:
# NIFTY_LAB_ROOT=/root/Options-Nifty-Edge-Lab
# BN_LAB_ROOT=/root/Options-Edge-Lab
NIFTY_CONFIG=config/rungs/paper_2l_nifty_tier2_recommended.yaml
BN_CONFIG=config/edge_book_2l_dd20.yaml

LIVE_NIFTY=0
LIVE_BANKNIFTY=0

# Weekday paper auto: arm both books ~09:10 IST, place PENDING, EOD flatten 15:30–15:45, disarm after.
# Stop in the UI pauses only for the rest of that IST day. Never arms live.
DESK_PAPER_AUTO=1

# Browser CORS (comma-separated). Default includes production UI + local Next dev.
# CORS_ALLOWED_ORIGINS=https://desk.ravindra-devireddy.com,http://localhost:3000
