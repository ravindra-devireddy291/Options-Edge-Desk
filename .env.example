# Desk API
DESK_API_KEY=change-me-desk-api-key
DESK_MODE=paper
DESK_HOST=127.0.0.1
DESK_PORT=8080

# Dhan HQ v2 — paste once; desk auto-renews while process stays up
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional unattended daily login if token fully expires (TOTP enabled on Dhan):
# DHAN_PIN=123456
# DHAN_TOTP_SECRET=BASE32SECRET

# Edge Lab roots
NIFTY_LAB_ROOT=D:/Options-Nifty-Edge-Lab
BN_LAB_ROOT=D:/Options-Edge-Lab
# VPS:
# NIFTY_LAB_ROOT=/root/Options-Nifty-Edge-Lab
# BN_LAB_ROOT=/root/Options-Edge-Lab
NIFTY_CONFIG=config/rungs/paper_2l_nifty_tier2_recommended.yaml
BN_CONFIG=config/edge_book_2l_dd20.yaml

LIVE_NIFTY=0
LIVE_BANKNIFTY=0

# Live cutover (all three + restart). Until then weekday auto stays paper. Never set these during the paper month.
# After written client confirmation:
#   DESK_LIVE_ENABLED=1
#   LIVE_NIFTY=1
#   LIVE_BANKNIFTY=1
# then: py -3 scripts/enable_live_vps.py --confirm-client-ready
# Same 09:10 IST auto / 15:45 EOD path, Dhan live. Process still boots STOPPED; schedule arms live.
# Kill switch still wins. get_settings is cached — restart is required.
DESK_LIVE_ENABLED=0

# Mock soak: loop the tape after 15:30 sim. Default 0 = one NSE-like session (same as paper/live).
DESK_MOCK_LOOP=0

# Weekday auto: arm both books ~09:10 IST, place PENDING, EOD flatten 15:30–15:45, disarm after.
# Paper while DESK_LIVE_ENABLED=0. Live after the cutover flags + restart.
DESK_PAPER_AUTO=1

# Browser CORS (comma-separated). Default includes production UI + local Next dev.
# CORS_ALLOWED_ORIGINS=https://desk.ravindra-devireddy.com,http://localhost:3000
