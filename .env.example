# Desk API
DESK_API_KEY=change-me-desk-api-key
DESK_MODE=paper
DESK_HOST=127.0.0.1
DESK_PORT=8080

# Dhan HQ v2 — paste once; desk auto-renews while process stays up.
# Individual access tokens expire ~24h. Prefer DHAN_PIN + DHAN_TOTP_SECRET (safe daily mint).
# A never-expiring JWT is not required and is worse if leaked. Charts ingest also needs
# an active Dhan Data API plan (₹499+tax/mo) — check Profile → dataPlan = Active.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Optional unattended daily login if token fully expires (TOTP enabled on Dhan):
# DHAN_PIN=123456
# DHAN_TOTP_SECRET=BASE32SECRET

# Edge Lab roots
NIFTY_LAB_ROOT=D:/Options-Nifty-Edge-Lab
BN_LAB_ROOT=D:/Options-Edge-Lab
# VPS:
# NIFTY_LAB_ROOT=/root/Options-Nifty-Edge-Lab
# BN_LAB_ROOT=/root/Options-Edge-Lab
NIFTY_CONFIG=config/rungs/nifty_alpha.yaml
BN_CONFIG=config/rungs/bn_alpha.yaml

LIVE_NIFTY=0
LIVE_BANKNIFTY=0

# Live stays off on this line. When the client allows it, change 0 to 1 and restart
# (or py -3 scripts/enable_live_vps.py --confirm-client-ready). A book stays on paper
# until it has 20 desk_paper fills. Kill switch still wins. Restart is required.
DESK_LIVE_ENABLED=0

# Mock soak: loop the tape after 15:30 sim. Default 0 = one NSE-like session (same as paper/live).
DESK_MOCK_LOOP=0

# Weekday auto: arm both books ~09:10 IST, place PENDING, EOD flatten 15:30–15:45, disarm after.
# Paper while DESK_LIVE_ENABLED=0. Live after that one value is 1 and the process restarts.
DESK_PAPER_AUTO=1
DESK_PAPER_ONLY=1

# Home book equity = capital + closed PnL since this IST day (ignore older lab shadow lifetime).
DESK_PAPER_BOOK_START=2026-08-17

# After 15:35 IST (and Monday catch-up): pull Dhan 1m charts into both lab data_lakes.
# Default on. Set 0 to pause. Does not need paper/live to be armed.
# DESK_LAKE_INGEST=1

# Browser CORS (comma-separated). Default includes production UI + local Next dev.
# CORS_ALLOWED_ORIGINS=https://desk.ravindra-devireddy.com,http://localhost:3000

# Leave off. /docs and /openapi.json stay closed unless 1.
# DESK_OPENAPI=0

# Client logins live in data/client_live.sqlite (WAL). Same file and these values move to the VPS later.
# GROWW_MODE=local records orders on this machine and does not call Groww.
# GROWW_MODE=live exchanges the TOTP on the desk machine only. Do not set that on the laptop for a real account.
# GROWW_LINK_KEY=
# GROWW_MODE=local
# DESK_OPERATOR_EMAIL=
# DESK_OPERATOR_PASSWORD=
# CLIENT_LIVE_DB=

# Shared with the UI BFF only (header X-Desk-BFF). Direct curl with DESK_API_KEY is denied.
# Generate on VPS; set the same value on Vercel. Never NEXT_PUBLIC_*.
# DESK_BFF_SECRET=

# VPS deploy / SSH (default port 443, not 22)
# EDGE_VPS_HOST=87.232.72.137
# EDGE_VPS_PORT=443
# EDGE_VPS_PASS=

# Cloudflare named tunnel (deskapi.ravindra-devireddy.com). Never commit.
# Zero Trust → Tunnels → Configure → cloudflared service install <TOKEN>
# CLOUDFLARE_TUNNEL_TOKEN=
